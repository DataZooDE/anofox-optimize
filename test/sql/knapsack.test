# name: test/sql/knapsack.test
# description: 0/1 knapsack decision algorithms
# group: [anofox_optimize]

require anofox_optimize

# The classic case where by-ratio LOSES: item 0 has the best ratio but
# taking it blocks the pair that is worth more. If a family has no member
# that beats the obvious heuristic, it is decorative.
query I
SELECT opt_knapsack_greedy_ratio([7.0, 4.0, 4.0], [5.0, 4.0, 4.0], 8.0).total_value;
----
7

query I
SELECT opt_knapsack_exact([7.0, 4.0, 4.0], [5.0, 4.0, 4.0], 8.0).total_value;
----
8

# Every member must return a FEASIBLE selection: total weight within
# capacity, one boolean per item.
query I
SELECT count(*) FROM (
  SELECT opt_knapsack_greedy_ratio([7.0,4.0,4.0],[5.0,4.0,4.0],8.0) AS r
  UNION ALL SELECT opt_knapsack_greedy_value([7.0,4.0,4.0],[5.0,4.0,4.0],8.0)
  UNION ALL SELECT opt_knapsack_exact([7.0,4.0,4.0],[5.0,4.0,4.0],8.0)
  UNION ALL SELECT opt_knapsack_best_of([7.0,4.0,4.0],[5.0,4.0,4.0],8.0)
) WHERE r.total_weight > 8.0 OR len(r.selected) <> 3;
----
0

# best_of never loses to a member it contains.
query I
SELECT opt_knapsack_best_of([7.0,4.0,4.0],[5.0,4.0,4.0],8.0).total_value
       >= opt_knapsack_greedy_value([7.0,4.0,4.0],[5.0,4.0,4.0],8.0).total_value;
----
true

# The exact member REFUSES an instance it cannot solve exactly rather
# than silently returning a heuristic answer that is no longer a bound.
statement error
SELECT opt_knapsack_exact([1.0], [1.0], 1e9);
----
over the

# Mismatched inputs, NULLs and nonsense are rejected with a reason.
statement error
SELECT opt_knapsack_greedy_ratio([1.0, 2.0], [1.0], 5.0);
----
same length

statement error
SELECT opt_knapsack_greedy_ratio([1.0], [-1.0], 5.0);
----
weights must be >= 0

statement error
SELECT opt_knapsack_greedy_ratio([1.0], ['nan'::DOUBLE], 5.0);
----
must be finite

# Zero capacity selects nothing, and that is a valid answer.
query I
SELECT opt_knapsack_exact([5.0, 3.0], [2.0, 1.0], 0.0).total_value;
----
0

# ── best_of is exact whenever exact can solve the instance ──────────────────

# The south depot of a delivery run, capacity 20: the best-ratio crate (s1)
# blocks the two crates that make the optimum (31 against 36), and the most
# valuable crate (s2) leaves room for nothing (27). best_of must not stop at
# the best greedy answer when the DP table is small.
statement ok
CREATE TABLE crates AS SELECT * FROM (VALUES
    (0, 11.0, 2.0), (1, 27.0, 19.0), (2, 18.0, 10.0), (3, 18.0, 10.0), (4, 2.0, 7.0)) t(k, val, kg);

# The optimum, found independently by trying every subset.
query R
SELECT max(tv) FROM (SELECT mask, sum(val) AS tv, sum(kg) AS tw FROM crates, range(0, 32) m(mask)
                     WHERE (mask >> k) & 1 = 1 GROUP BY mask) WHERE tw <= 20;
----
36.0

query RRRR
WITH l AS (SELECT list(val ORDER BY k) AS v, list(kg ORDER BY k) AS w FROM crates)
SELECT opt_knapsack_best_of(v, w, 20.0).total_value, opt_knapsack_exact(v, w, 20.0).total_value,
       opt_knapsack_greedy_ratio(v, w, 20.0).total_value, opt_knapsack_greedy_value(v, w, 20.0).total_value
FROM l;
----
36.0	36.0	31.0	27.0

# The long form defaults to best_of, so its default is the optimum too.
query R
SELECT sum(value) FILTER (selected) FROM opt_knapsack_by('(SELECT k, val, kg FROM crates)', 'k', 'val', 'kg', 20.0);
----
36.0

# Many instances at once: best_of equals the brute-force optimum on every
# one of them, and is never below any member. 300 instances of 8 items with
# integer weights; the greedy members miss the optimum on a measurable share,
# so the fixture separates them.
statement ok
CREATE TABLE many AS
SELECT g, k, (1 + (g * 7 + k * 13) % 23)::DOUBLE AS val, (1 + (g * 5 + k * 11) % 17)::DOUBLE AS kg
FROM range(0, 300) a(g), range(0, 8) b(k);

statement ok
CREATE TABLE many_brute AS
SELECT g, max(tv) AS optimum FROM (
    SELECT g, mask, sum(val) AS tv, sum(kg) AS tw FROM many, range(0, 256) m(mask)
    WHERE (mask >> k) & 1 = 1 GROUP BY ALL) WHERE tw <= 30 GROUP BY g;

statement ok
CREATE TABLE many_solved AS
WITH l AS (SELECT g, list(val ORDER BY k) AS v, list(kg ORDER BY k) AS w FROM many GROUP BY g)
SELECT g, opt_knapsack_best_of(v, w, 30.0) AS b, opt_knapsack_exact(v, w, 30.0) AS e,
       opt_knapsack_greedy_ratio(v, w, 30.0) AS r, opt_knapsack_greedy_value(v, w, 30.0) AS gv
FROM l;

query IIII
SELECT count(*), count(*) FILTER (b.total_value = optimum),
       count(*) FILTER (b.total_value >= r.total_value AND b.total_value >= gv.total_value AND b.total_value >= e.total_value),
       count(*) FILTER (b.total_weight <= 30.0 AND len(b.selected) = 8)
FROM many_solved JOIN many_brute USING (g);
----
300	300	300	300

# The fixture is not degenerate: the best greedy answer misses the optimum
# on some instances.
query I
SELECT count(*) FILTER (greatest(r.total_value, gv.total_value) < optimum) > 0
FROM many_solved JOIN many_brute USING (g);
----
true

# best_of >= every member on the classic fixture, too.
query I
SELECT opt_knapsack_best_of([7.0,4.0,4.0],[5.0,4.0,4.0],8.0).total_value
       = opt_knapsack_exact([7.0,4.0,4.0],[5.0,4.0,4.0],8.0).total_value;
----
true

# When exact would REFUSE (here a 200M-cell table), best_of does NOT error:
# it returns the best greedy answer, which is feasible but no longer a bound.
# by-value wins this instance (10 against 6), so best_of must take the max.
statement error
SELECT opt_knapsack_exact([10.0, 6.0], [1e8, 5e7], 1e8);
----
over the

query RRRR
SELECT opt_knapsack_best_of([10.0, 6.0], [1e8, 5e7], 1e8).total_value,
       opt_knapsack_best_of([10.0, 6.0], [1e8, 5e7], 1e8).total_weight,
       opt_knapsack_greedy_ratio([10.0, 6.0], [1e8, 5e7], 1e8).total_value,
       opt_knapsack_greedy_value([10.0, 6.0], [1e8, 5e7], 1e8).total_value;
----
10.0	100000000.0	6.0	10.0

# ...and on the classic fixture scaled past the limit: both greedy members
# return 7, so best_of returns 7 and the optimum of 8 stays out of reach.
query RR
SELECT opt_knapsack_best_of([7.0, 4.0, 4.0], [5e7, 4e7, 4e7], 8e7).total_value,
       greatest(opt_knapsack_greedy_ratio([7.0, 4.0, 4.0], [5e7, 4e7, 4e7], 8e7).total_value,
                opt_knapsack_greedy_value([7.0, 4.0, 4.0], [5e7, 4e7, 4e7], 8e7).total_value);
----
7.0	7.0

# Weights too fine to scale to integers are rounded inside the DP table;
# best_of must still never return a selection over capacity.
query I
SELECT opt_knapsack_best_of([1.0, 1.0], [0.00004, 0.00004], 0.00007).total_weight <= 0.00007;
----
true
