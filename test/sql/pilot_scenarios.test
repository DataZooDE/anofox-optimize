# ---------------------------------------------------------------- P7 --
# Cardinality-constrained portfolio: 20 assets, hold at most 5, no position
# above 35%. The three highest-return assets are a deliberately CORRELATED
# cluster, so buying by return is the trap.
#
# Reference Sharpe 5.329278, from enumerating all C(20,5)=15504 subsets and
# refining the best 400 under the position cap — computed outside this
# extension.

statement ok
CREATE TABLE p7 AS SELECT [0.051,0.192,0.043,0.068,0.045,0.102,0.106,0.169,0.162,0.138,0.142,0.151,0.197,0.185,0.047,0.05,0.13,0.092,0.095,0.084]::DOUBLE[] AS r, [0.032761,-0.008749,0.002675,-0.009697,-0.001526,0.004254,-0.004137,0.0064,0.005338,-0.011039,0.003984,0.001803,-0.003755,0.006627,-0.007936,0.005723,-0.014274,-0.012035,-0.004154,-0.004929,-0.008749,0.145161,0.032578,0.028084,-0.01949,0.001031,-0.01295,0.060174,0.067302,0.071363,0.042728,0.069737,0.067869,0.112225,-0.01565,-0.001046,0.01756,0.000112,-0.007471,-0.024739,0.002675,0.032578,0.156816,-0.008705,-0.011887,-0.0116,-0.001494,0.01794,0.014561,0.00314,0.004739,-0.014332,0.019669,0.012403,-0.015614,0.004968,-0.038364,0.029799,-0.030996,-0.024521,-0.009697,0.028084,-0.008705,0.131769,0.01011,-0.011691,0.006943,-0.013377,0.008925,0.018663,-0.01276,-0.021596,0.006663,-0.032045,0.005558,0.031728,-0.026054,-0.022405,0.028969,0.003416,-0.001526,-0.01949,-0.011887,0.01011,0.033489,-0.00527,0.005959,-0.001555,-0.008612,0.005122,-0.00318,-0.000195,0.009537,0.012897,-0.003403,0.011102,0.006896,0.011066,0.011671,0.008703,0.004254,0.001031,-0.0116,-0.011691,-0.00527,0.024025,0.000955,-0.006949,-0.00774,-0.005725,0.001296,0.005903,0.002306,-0.012549,0.001157,-0.010518,0.01018,0.011986,-0.012732,0.008327,-0.004137,-0.01295,-0.001494,0.006943,0.005959,0.000955,0.021025,0.001354,-0.000792,0.001407,0.003171,0.005353,0.004877,-9.9e-05,-0.001969,0.003027,-0.006067,-0.008541,0.000808,0.002619,0.0064,0.060174,0.01794,-0.013377,-0.001555,-0.006949,0.001354,0.0289,0.029375,0.032262,0.020139,0.032135,0.029436,0.045118,-0.00729,0.009749,0.014607,-0.002093,0.011043,-0.013829,0.005338,0.067302,0.014561,0.008925,-0.008612,-0.00774,-0.000792,0.029375,0.04,0.038477,0.023387,0.038117,0.039715,0.054815,0.000806,-0.009,-0.004341,-0.003614,0.003506,0.003067,-0.011039,0.071363,0.00314,0.018663,0.005122,-0.005725,0.001407,0.032262,0.038477,0.046656,0.028108,0.042739,0.045692,0.056919,-0.012042,-0.007692,-0.014788,-0.014253,0.015766,-0.0