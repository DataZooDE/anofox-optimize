# Must reach the reference optimum.
query I
SELECT round(opt_portfolio_best_of(r,cov,k,cap).sharpe, 4) FROM p7;
----
5.3293

# ... and must not EXCEED it: a Sharpe above the enumerated best would mean
# the weights violate the cap or the volatility is being under-computed.
query I
SELECT opt_portfolio_best_of(r,cov,k,cap).sharpe <= 5.3293 FROM p7;
----
true

# Buying the top returns is the trap, and must be clearly beaten.
query I
SELECT opt_portfolio_top_return(r,cov,k,cap).sharpe < 1.0 FROM p7;
----
true

# Constraints hold: at most k holdings, no weight over the cap, weights sum to 1.
query I
SELECT len(list_filter(opt_portfolio_best_of(r,cov,k,cap).weights, w -> w > 1e-9)) <= 5 FROM p7;
----
true

query I
SELECT bool_and(w <= 0.35 + 1e-9) FROM (
  SELECT unnest(opt_portfolio_best_of(r,cov,k,cap).weights) AS w FROM p7);
----
true

query I
SELECT abs(list_sum(opt_portfolio_best_of(r,cov,k,cap).weights) - 1.0) < 1e-6 FROM p7;
----
true
