# name: test/sql/batching.test
# description: priority-weighted wave batching (P2's objective)
# group: [anofox_optimize]

require anofox_optimize

# Two full-wave orders and one small urgent one. Size-first fills waves 1
# and 2 exactly, stranding the urgent order in wave 3; priority-aware
# batching puts it first. The instance matters: an earlier version used
# [6,1,6] where the urgent order slipped into wave 1 under EVERY rule, so
# all five members returned 1.0909 — no spread at all, the "family is
# decorative" failure AGENTS.md warns about, and the test could not see it.
statement ok
CREATE TABLE b AS SELECT [7.0, 7.0, 1.0]::DOUBLE[] AS items,
                         [1.0, 1.0, 9.0]::DOUBLE[] AS prio, 7.0 AS cap;

# Every member assigns exactly one wave per order, all >= 1, and no wave
# exceeds capacity. An algorithm that silently overfilled a wave would
# simply win.
query I
WITH r AS (
  SELECT 'as_given' algo, opt_wave_as_given(items,prio,cap) v, items, cap FROM b
  UNION ALL SELECT 'priority_first', opt_wave_priority_first(items,prio,cap), items, cap FROM b
  UNION ALL SELECT 'priority_density', opt_wave_priority_density(items,prio,cap), items, cap FROM b
  UNION ALL SELECT 'fewest_waves', opt_wave_fewest_waves(items,prio,cap), items, cap FROM b
  UNION ALL SELECT 'best_of', opt_wave_best_of(items,prio,cap), items, cap FROM b
)
SELECT count(*) FROM r WHERE len(v.wave) <> len(items) OR list_min(v.wave) < 1;
----
0

# No wave exceeds capacity, for any algorithm. An algorithm that silently
# overfilled a wave would simply win an optimising search. A wave fits when
# its sizes, summed in ITEM order in doubles, are within capacity; an
# unordered sum() has no defined order, so the check uses an ordered list_sum.
query I
WITH r AS (
  SELECT 'as_given' algo, opt_wave_as_given(items,prio,cap) v, items, cap FROM b
  UNION ALL SELECT 'priority_first', opt_wave_priority_first(items,prio,cap), items, cap FROM b
  UNION ALL SELECT 'priority_density', opt_wave_priority_density(items,prio,cap), items, cap FROM b
  UNION ALL SELECT 'fewest_waves', opt_wave_fewest_waves(items,prio,cap), items, cap FROM b
  UNION ALL SELECT 'best_of', opt_wave_best_of(items,prio,cap), items, cap FROM b
),
loads AS (
  SELECT algo, v.wave[i] AS w, list_sum(list(items[i] ORDER BY i)) AS load, any_value(cap) AS cap
  FROM r, generate_series(1, len(items)) g(i)
  GROUP BY algo, v.wave[i]
)
SELECT count(*) FROM loads WHERE load > cap;
----
0

# Real SPREAD: optimising wave COUNT is the wrong objective here and pays
# for it against priority-aware batching.
query I
SELECT opt_wave_fewest_waves(items,prio,cap).avg_weighted_wave
       > opt_wave_priority_density(items,prio,cap).avg_weighted_wave FROM b;
----
true

query I
SELECT opt_wave_best_of(items,prio,cap).avg_weighted_wave
       <= LEAST(opt_wave_as_given(items,prio,cap).avg_weighted_wave,
                opt_wave_fewest_waves(items,prio,cap).avg_weighted_wave) FROM b;
----
true

# An order that cannot fit any wave is a caller error, named precisely.
statement error
SELECT opt_wave_priority_first([9.0]::DOUBLE[], [1.0]::DOUBLE[], 7.0);
----
cannot be batched

statement error
SELECT opt_wave_priority_first([1.0,2.0]::DOUBLE[], [1.0]::DOUBLE[], 7.0);
----
were required

# ── decimal sizes: every wave fits in item order ────────────────────────────

# 2000 sets of 12 orders, sizes from 0.1 to 0.9, at a capacity of 1.0. Packed
# by priority, 0.3 + 0.2 + 0.1 is 0.6, but in item order 0.1 + 0.2 + 0.3 is
# 0.6000000000000001; members once returned waves over capacity that way on
# up to 31 of these sets. Waves stay 1-based and contiguous, and
# avg_weighted_wave is the objective of the waves returned.
query II
SELECT opt_wave_priority_first([0.1, 0.2, 0.3]::DOUBLE[], [1.0, 2.0, 3.0]::DOUBLE[], 0.6).wave,
       opt_wave_priority_first([0.1, 0.2, 0.3]::DOUBLE[], [1.0, 2.0, 3.0]::DOUBLE[], 0.6).avg_weighted_wave;
----
[2, 1, 1]	1.1666666666666667

statement ok
CREATE TABLE dec AS
SELECT g, list((1 + hash(g, k) % 9)::DOUBLE / 10 ORDER BY k) AS items,
       list((1 + hash(g, k, 'p') % 9)::DOUBLE ORDER BY k) AS prio
FROM range(0, 2000) a(g), range(0, 12) b(k) GROUP BY g;

statement ok
CREATE TABLE dec_results AS
SELECT g, items, prio, unnest(['as_given', 'priority_first', 'priority_density', 'fewest_waves', 'best_of']) AS algo,
       unnest([opt_wave_as_given(items, prio, 1.0), opt_wave_priority_first(items, prio, 1.0),
               opt_wave_priority_density(items, prio, 1.0), opt_wave_fewest_waves(items, prio, 1.0),
               opt_wave_best_of(items, prio, 1.0)]) AS v
FROM dec;

query I
SELECT count(*) FILTER (load > 1.0) FROM (
  SELECT g, algo, v.wave[i] AS w, list_sum(list(items[i] ORDER BY i)) AS load
  FROM dec_results, generate_series(1, 12) t(i) GROUP BY ALL);
----
0

query II
SELECT count(*), count(*) FILTER (len(list_distinct(v.wave)) = list_max(v.wave) AND list_min(v.wave) = 1
                                  AND abs(v.avg_weighted_wave - list_sum(list_transform(v.wave, lambda w, i: w * prio[i]))
                                          / list_sum(prio)) < 1e-12)
FROM dec_results;
----
10000	10000

# best_of still never loses to a member, judged on the repaired waves.
query I
SELECT count(*) FROM (SELECT g, min(v.avg_weighted_wave) FILTER (algo <> 'best_of') AS m,
                             any_value(v.avg_weighted_wave) FILTER (algo = 'best_of') AS b
                      FROM dec_results GROUP BY g) WHERE b > m;
----
0
