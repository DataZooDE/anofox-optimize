# name: test/sql/matrix.test
# description: building matrices from the triples the pilots actually store
# group: [anofox_optimize]

require anofox_optimize

# 1-based triples become a row-major matrix with 0 fill.
query I
SELECT opt_matrix_from_triples([1,2]::BIGINT[], [2,1]::BIGINT[], [0.5,0.7]::DOUBLE[], 2, 1);
----
[0.0, 0.5, 0.7, 0.0]

# 0-based ids too.
query I
SELECT opt_matrix_from_triples([0]::BIGINT[], [1]::BIGINT[], [9.0]::DOUBLE[], 2, 0);
----
[0.0, 9.0, 0.0, 0.0]

# It composes with the families that need a matrix — this is the whole
# point, since the pilots store triples and the families want DOUBLE[].
query I
WITH t(a,b,v) AS (VALUES (1,1,0.04),(1,2,0.036),(2,1,0.036),(2,2,0.04),
                         (1,3,-0.01),(3,1,-0.01),(2,3,-0.01),(3,2,-0.01),(3,3,0.04))
SELECT opt_portfolio_greedy_sharpe(
         [0.12,0.12,0.10]::DOUBLE[],
         opt_matrix_from_triples(list(a)::BIGINT[], list(b)::BIGINT[], list(v)::DOUBLE[], 3, 1),
         2, 0.6).sharpe > 0.8 FROM t;
----
true

# A duplicate cell would silently keep whichever came last.
statement error
SELECT opt_matrix_from_triples([1,1]::BIGINT[], [2,2]::BIGINT[], [1.0,2.0]::DOUBLE[], 2, 1);
----
already set

# An id outside the matrix is a caller error naming n and index_base.
statement error
SELECT opt_matrix_from_triples([5]::BIGINT[], [1]::BIGINT[], [1.0]::DOUBLE[], 2, 1);
----
index_base

statement error
SELECT opt_matrix_from_triples([1,2]::BIGINT[], [1]::BIGINT[], [1.0]::DOUBLE[], 2, 1);
----
same length
