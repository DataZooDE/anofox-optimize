# name: test/sql/packing.test
# description: bin-packing decision algorithms
# group: [anofox_optimize]

require anofox_optimize

# Three items of 4, 8, 1 into bins of 10: 8+1 and 4, or 4+1 and 8 -> 2 bins.
query I
SELECT opt_pack_first_fit_decreasing([4.0, 8.0, 1.0], 10.0).bins_used;
----
2

# Every family member must return a VALID packing: no bin over capacity,
# and every item assigned exactly once.
query I
WITH p AS (SELECT opt_pack_best_fit_decreasing([6.0,5.0,4.0,7.0,2.0,3.0,8.0,1.0], 10.0) AS r)
SELECT len(r.assignment) FROM p;
----
8

# Next-fit is the weak member and must not beat the decreasing heuristics
# on an instance built to punish it.
query I
SELECT opt_pack_next_fit([6.0,5.0,4.0,7.0,2.0,3.0,8.0,1.0], 10.0).bins_used
       >= opt_pack_first_fit_decreasing([6.0,5.0,4.0,7.0,2.0,3.0,8.0,1.0], 10.0).bins_used;
----
true

# An item larger than the bin has no packing at all — say so rather than
# silently dropping it, which is the exploit shape a search will find.
statement error
SELECT opt_pack_first_fit_decreasing([11.0], 10.0);
----
exceeds capacity

statement error
SELECT opt_pack_first_fit_decreasing([1.0], 0.0);
----
capacity must be > 0

# The improvement member must actually beat the greedy ones where they
# stall. Falkenauer triplet instance: an exact 3-per-bin partition exists
# (optimum 10 bins), and first-fit-decreasing provably does not find it.
query I
SELECT opt_pack_first_fit_decreasing(
  [418.0,274.0,301.0,392.0,270.0,251.0,269.0,290.0,282.0,437.0,440.0,261.0,483.0,391.0,458.0,
   318.0,315.0,403.0,456.0,309.0,254.0,307.0,437.0,266.0,289.0,275.0,268.0,291.0,314.0,281.0],
  1000.0).bins_used;
----
12

# The family must have genuine SPREAD on this instance, or "swap the
# algorithm" changes the name and not the result. Bin completion is the
# member that breaks the greedy tie; relocation-only local search
# legitimately does not, and that is fine as long as someone does.
query I
SELECT opt_pack_bin_completion(
  [418.0,274.0,301.0,392.0,270.0,251.0,269.0,290.0,282.0,437.0,440.0,261.0,483.0,391.0,458.0,
   318.0,315.0,403.0,456.0,309.0,254.0,307.0,437.0,266.0,289.0,275.0,268.0,291.0,314.0,281.0],
  1000.0).bins_used < 12;
----
true

# best_of can never lose to any individual member.
query I
SELECT opt_pack_best_of([6.0,5.0,4.0,7.0,2.0,3.0,8.0,1.0], 10.0).bins_used
       <= LEAST(opt_pack_first_fit_decreasing([6.0,5.0,4.0,7.0,2.0,3.0,8.0,1.0], 10.0).bins_used,
                opt_pack_next_fit([6.0,5.0,4.0,7.0,2.0,3.0,8.0,1.0], 10.0).bins_used);
----
true

# Every algorithm must return a FEASIBLE packing: no bin over capacity.
# A search will exploit any function that quietly returns an invalid one.
query I
WITH s(sizes) AS (SELECT [418.0,274.0,301.0,392.0,270.0,251.0,269.0,290.0,282.0,437.0]),
     p AS (SELECT sizes, opt_pack_local_search(sizes, 1000.0) AS r FROM s),
     loads AS (SELECT r.assignment[i] AS bin, sizes[i] AS sz
               FROM p, generate_series(1, len(sizes)) g(i))
SELECT max(total) <= 1000.0 FROM (SELECT bin, sum(sz) AS total FROM loads GROUP BY bin);
----
true

# A non-finite or negative size is not a packing problem. Both slipped
# through silently and returned a confident WRONG answer: [-5.0, 3.0]
# reported 1 bin, and ['nan', 3.0] reported 2, because every comparison
# against NaN is false so it passed the capacity check and then fitted
# nowhere. Silently-wrong is the worst failure mode for a function a
# search optimises against.
statement error
SELECT opt_pack_first_fit_decreasing([-5.0, 3.0], 10.0);
----
must be >= 0

statement error
SELECT opt_pack_first_fit_decreasing(['nan'::DOUBLE, 3.0], 10.0);
----
must be finite

statement error
SELECT opt_pack_best_of([3.0, 'inf'::DOUBLE], 10.0);
----
must be finite

statement error
SELECT opt_pack_first_fit_decreasing([1.0], 'nan'::DOUBLE);
----
must be finite

# An empty item list is a valid, degenerate problem: zero bins.
query I
SELECT opt_pack_first_fit_decreasing([]::DOUBLE[], 10.0).bins_used;
----
0

# FEASIBILITY ACROSS THE WHOLE FAMILY (codex review finding, Medium).
# Previously only one algorithm's assignment length and one algorithm's
# capacity were checked. For functions an LLM search optimises against,
# a member that quietly returns an infeasible packing would simply win —
# so every member must satisfy every invariant on an adversarial case.
#
# Invariants: exactly one assignment per item; every bin id < bins_used;
# no bin over capacity.
statement ok
CREATE TABLE adversarial AS
SELECT [418.0,274.0,301.0,392.0,270.0,251.0,269.0,290.0,282.0,437.0,440.0,261.0,483.0,391.0,
        458.0,318.0,315.0,403.0,456.0,309.0,254.0,307.0,437.0,266.0,289.0,275.0,268.0,291.0,
        314.0,281.0] AS sizes, 1000.0 AS cap;

statement ok
CREATE TABLE results AS
SELECT 'first_fit_decreasing' AS algo, opt_pack_first_fit_decreasing(sizes, cap) AS r, sizes, cap FROM adversarial
UNION ALL SELECT 'best_fit_decreasing', opt_pack_best_fit_decreasing(sizes, cap), sizes, cap FROM adversarial
UNION ALL SELECT 'worst_fit_decreasing', opt_pack_worst_fit_decreasing(sizes, cap), sizes, cap FROM adversarial
UNION ALL SELECT 'next_fit', opt_pack_next_fit(sizes, cap), sizes, cap FROM adversarial
UNION ALL SELECT 'local_search', opt_pack_local_search(sizes, cap), sizes, cap FROM adversarial
UNION ALL SELECT 'bin_completion', opt_pack_bin_completion(sizes, cap), sizes, cap FROM adversarial
UNION ALL SELECT 'best_of', opt_pack_best_of(sizes, cap), sizes, cap FROM adversarial;

# Every algorithm assigns exactly one bin per item.
query I
SELECT count(*) FROM results WHERE len(r.assignment) <> len(sizes);
----
0

# No assignment is NULL — this is what the child-validity fix protects.
query I
SELECT count(*) FROM results, generate_series(1, len(sizes)) g(i)
WHERE r.assignment[i] IS NULL;
----
0

# Every bin id is within range.
query I
SELECT count(*) FROM results, generate_series(1, len(sizes)) g(i)
WHERE r.assignment[i] >= r.bins_used;
----
0

# No bin exceeds capacity, for any algorithm.
query I
SELECT count(*) FROM (
  SELECT algo, r.assignment[i] AS bin, sum(sizes[i]) AS load, any_value(cap) AS cap
  FROM results, generate_series(1, len(sizes)) g(i)
  GROUP BY algo, r.assignment[i]
) WHERE load > cap;
----
0

# And every algorithm uses at least the theoretical lower bound.
query I
SELECT count(*) FROM results
WHERE r.bins_used < CEIL(list_sum(sizes) / cap);
----
0
